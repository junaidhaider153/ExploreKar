# ─────────────────────────────────────────────────────────────────────────────
# ExploreKar — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Project Settings -> API) ---
# Public URL and Anonymous Key safe for client-side browser requests (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only Service Role key. NEVER prefix with NEXT_PUBLIC_.
# Used exclusively in secure server-side API routes that require elevated access.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Google Gemini AI (Room Vision & Spatial Matching) ---
# Get your API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# --- App URL Configuration ---
# Absolute URL used for SEO sitemaps, Open Graph images, and auth confirmation callbacks.
# On Vercel, this defaults to VERCEL_URL if omitted.
NEXT_PUBLIC_SITE_URL=https://explorekar.com

# --- WhatsApp Order Inquiry ---
# Business phone number for instant WhatsApp inquiries (country code, no + prefix).
# Example for Pakistan (+92 300 1234567): 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
